#!/usr/bin/env bash
#
# Regenerate attachment-reflection-config.js from the questions JSON whenever
# that JSON is part of the commit, and stage the regenerated config so it lands
# in the same commit. Keeps the committed config in sync with the data file.
#
# Installed via a committed hooks dir: run once per clone (or use ./install-hooks.sh):
#     git config core.hooksPath .githooks
#
set -euo pipefail

JSON_FILE="attachment-reflection-questions.json"
CONFIG_FILE="attachment-reflection-config.js"

# Only do work when the questions JSON is staged; otherwise this is a no-op.
if ! git diff --cached --name-only | grep -qx "$JSON_FILE"; then
  exit 0
fi

# Find a way to run node. Prefer node on PATH; fall back to nix-shell (this
# repo's environment has no global node).
run_node() {
  if command -v node >/dev/null 2>&1; then
    node "$@"
  elif command -v nix-shell >/dev/null 2>&1; then
    nix-shell -p nodejs --run "node $*"
  else
    echo "pre-commit: neither 'node' nor 'nix-shell' found — cannot regenerate config" >&2
    echo "            run 'npm run generate' manually and re-commit." >&2
    exit 1
  fi
}

echo "pre-commit: $JSON_FILE changed — regenerating $CONFIG_FILE"
run_node generate-config.js

# Stage ONLY the generated config (never anything else), so unrelated unstaged
# edits are not swept into the commit.
if ! git diff --quiet -- "$CONFIG_FILE"; then
  git add "$CONFIG_FILE"
  echo "pre-commit: staged regenerated $CONFIG_FILE"
fi
